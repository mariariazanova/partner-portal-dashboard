# API Configuration
VITE_API_BASE_URL=/api
VITE_MOCK_MODE=true

# Mock API Behavior Configuration
# ================================

# Delay range (in milliseconds)
# Simulates realistic network latency with variability
VITE_MOCK_MIN_DELAY=300
VITE_MOCK_MAX_DELAY=1000

# Error simulation (0-100 percentage)
# VITE_MOCK_ERROR_RATE: Percentage chance of 500 Internal Server Error
# VITE_MOCK_TIMEOUT_RATE: Percentage chance of request timeout
# Set to 0 to disable errors completely
VITE_MOCK_ERROR_RATE=0
VITE_MOCK_TIMEOUT_RATE=0

# Timeout duration (in milliseconds)
# Maximum time before a request times out
VITE_MOCK_TIMEOUT_DURATION=5000

# ================================
# Example configurations:
# ================================

# Testing error handling (10% error rate, 5% timeout rate)
# VITE_MOCK_ERROR_RATE=10
# VITE_MOCK_TIMEOUT_RATE=5

# Fast development (no delays)
# VITE_MOCK_MIN_DELAY=0
# VITE_MOCK_MAX_DELAY=0

# Slow network simulation (2-5 seconds)
# VITE_MOCK_MIN_DELAY=2000
# VITE_MOCK_MAX_DELAY=5000

# High error rate for stress testing
# VITE_MOCK_ERROR_RATE=30
# VITE_MOCK_TIMEOUT_RATE=20
